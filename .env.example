# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_B2B_STARTER=price_...

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Billing feature flag: B2B_ONLY | B2C_ONLY | DUAL ---
BILLING_MODE=B2B_ONLY

# --- Revenue share (B2C -> salon) ---
REVENUE_SHARE_PERCENT=30

# --- Data retention (days after Client withdrawal until physical delete) ---
DATA_RETENTION_DAYS=30

# --- Photo storage ---
# supabase_only | gdrive_only | dual
PHOTO_STORAGE_MODE=supabase_only
# Browser-side hint for the camera modal banner ("Google ドライブにも保存されます").
NEXT_PUBLIC_PHOTO_STORAGE_MODE=supabase_only
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: Drive folder under which to nest "Senacare/". Defaults to user root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
